{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run css:build && vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "css:build": "tailwindcss -c tailwind.config.cjs -i src/styles/tailwind.css -o public/static/tailwind.css && node scripts/tailwind-version.mjs"
  },
  "browserslist": [
    "defaults",
    "safari >= 12",
    "ios_saf >= 12"
  ],
  "dependencies": {
    "hono": "^4.12.11"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "tailwindcss": "3.4.17",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
